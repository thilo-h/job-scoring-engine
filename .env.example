# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only ANTHROPIC_API_KEY is needed to run the LLM parts. Everything else is
# optional: scraping, deterministic scoring and the dashboard work without any
# of it.

# ── Anthropic API ───────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Set this instead of a key to run the LLM features against canned responses
# from fixtures/llm/. Nothing leaves the machine. The whole test suite runs in
# this mode, and so does the dashboard:
#   ANTHROPIC_MOCK=1 uvicorn dashboard.app:app
# ANTHROPIC_MOCK=1

# ── Profile ─────────────────────────────────────────────────────────────
# Loads config/profile_<name>.yaml. Ships with `example`.
JOBFINDER_PROFILE=example

# ── Dashboard (HTTP basic auth) ──────────────────────────────────────────
# Both empty = no authentication. Only leave them empty on localhost.
DASHBOARD_USER=
DASHBOARD_PASS=

# ── Notifications to your own address ───────────────────────────────────
# The only path in the project that sends mail, and it only ever sends to you.
# true (the default) writes .eml files to data/outbox/notifications/ instead of
# sending, so you can see exactly what would go out.
NOTIFY_DRY_RUN=true
NOTIFY_EMAIL_TO=you@example.com

# SMTP, only needed with NOTIFY_DRY_RUN=false.
# Use an app-specific password, never your account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=Job Scoring Engine

# ── IMAP reply tracking (optional) ──────────────────────────────────────
# Reads replies from a mailbox and classifies them. Read-only: it never sends,
# moves or deletes anything.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASS=your-app-password-here
IMAP_MAILBOX=INBOX
# true lets a confident classification move an application's status by itself.
# Mid-confidence replies are always left for manual review.
REPLY_AUTO_BUMP=false

# ── DOCX → PDF (optional) ───────────────────────────────────────────────
# LibreOffice headless, used to render a letter for download. The macOS
# default path is compiled in; override it here on Linux.
LIBREOFFICE_PATH=/usr/bin/soffice
